27","HR/Vhc","l"],["he","עִם",null,"H5973","HR"],["he","נְדִיבִ֑ים",null,"H5081","HAampa"],["he","עִ֝֗ם",null,"H5973","HR"],["he","נְדִיבֵ֥י",null,"H5081","HAampc"],["he","עַמּֽוֹ",null,"H5971","HNcmsc/Sp3ms"]],"9":[["he","מֽוֹשִׁיבִ֨י",null,"H3427","HVhrmsc"],["he","עֲקֶ֬רֶת",null,"H6135","HAafsc"],["he","הַבַּ֗יִת",null,"H1004","HTd/Ncmsa","d"],["he","אֵֽם",null,"H517","HNcfsc"],["he","הַבָּנִ֥ים",null,"H1121","HTd/Ncmpa","d"],["he","שְׂמֵחָ֗ה",null,"H8056","HAafsa"],["he","הַֽלְלוּ",null,"H1984","HVpv2mp"],["he","יָֽהּ",null,"H3050","HNp"]]},"gl":{"H1984":"to shine","H3050":"LORD","H5650":"servant/slave","H3068":"LORD","H853":"[Obj.]","H8034":"name","H1961":"to be","H1288":"to bless","H6258":"now","H5704":"till","H5769":"enduring","H4217":"East (Gate)","H8121":"sun","H3996":"entrance","H7311":"to exalt","H5921":"upon","H3605":"all","H1471":"nation","H8064":"heaven","H3519":"glory","H4310":"who?","H430":"God","H1361":"to exult","H3427":"to dwell","H8213":"to abase","H7200":"see","H776":"country/planet","H6965":"(Leb)-kamai","H6083":"dust","H1800":"poor","H830":"Dung (Gate)","H34":"needy","H5973":"with","H5081":"willing","H5971":"people","H6135":"barren","H1004":"place","H517":"mother","H1121":"child","H8056":"glad"},"ccc":{"0":[2143],"1":[2143],"2":[2143]},"cccp":{"2143":"__P7I#"},"com":[["haydock",1,null,"haydock","Alleluia. The Jews style this, and the five following psalms, “the great Alleluia,” which they sing after eating the paschal lamb. Eusebius adds, “a psalm of Aggæus and Zacharias,” as it seems to speak of the captives, who return thanks for their deliverance; (Isaias xlv. 6., &c.; Calmet) or David has left this model of thanksgiving for all. (Berthier) — Children. Hebrew, “slaves.” (Menochius) — The Greek and Latin may signify both. (Haydock) — He addresses the Levites, who were addicted to God’s service, or the new converts, who were become docile like little children, (1 Peter ii. 2., and Psalm viii. 3.; Calmet) and in a word, (Haydock) all God’s servants. (Worthington)"],["haydock",3,null,"chrysostom","Same. All the day long, (Calmet) or rather in all places. (Muis) (Malachias i. 10.) (St. Chrysostom)"],["haydock",6,null,"haydock","Earth. Providence watches over all, Psalm cxxxvii. 6. (Haydock) — With respect to God, even those who are in heaven are low. (Worthington)"],["haydock",7,null,"haydock","Poor. Jesus Christ and his servants, as well as Joseph, Mardochai, &c., 1 Kings ii. 8., and Luke i. 51. (Calmet)"],["haydock",9,null,"haydock","Children. Anna and Elizabeth, who were naturally barren, were blessed with what they so eagerly desired, by the divine power. (Haydock) — It may be understood of the Gentile world, after it had embraced the faith, (St. Jerome; Galatians iv. 17.; St. Chrysostom) or of the captives, (Isaias lvi. 1., and xlix. 21., and Psalm lxvii. 7.; Calmet) though Isaias may also refer to the Church. (Haydock) — Joseph was wonderfully advanced in glory, and Sara, Rebecca, &c., were made fruitful."]],"au":{"haydock":["George Leo Haydock",0,0,1849,"https://www.newadvent.org/cathen/07160a.htm"],"chrysostom":["John Chrysostom",1,1,407,"https://www.newadvent.org/fathers/#chrysostom"]}}