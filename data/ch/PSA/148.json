,"H7682","HVNrmsa"],["he","שְׁמ֣וֹ",null,"H8034","HNcmsc/Sp3ms"],["he","לְבַדּ֑וֹ",null,"H905","HR/Ncmsc/Sp3ms","l"],["he","ה֝וֹד֗וֹ",null,"H1935","HNcmsc/Sp3ms"],["he","עַל",null,"H5921","HR"],["he","אֶ֥רֶץ",null,"H776","HNcbsa"],["he","וְשָׁמָֽיִם",null,"H8064","HC/Ncmpa","c"]],"14":[["he","וַיָּ֤רֶם",null,"H7311","HC/Vhw3ms","c"],["he","קֶ֨רֶן",null,"H7161","HNcbsa"],["he","לְעַמּ֡וֹ",null,"H5971","HR/Ncmsc/Sp3ms","l"],["he","תְּהִלָּ֤ה",null,"H8416","HNcfsa"],["he","לְֽכָל",null,"H3605","HR/Ncmsc","l"],["he","חֲסִידָ֗יו",null,"H2623","HAampc/Sp3ms"],["he","לִבְנֵ֣י",null,"H1121","HR/Ncmpc","l"],["he","יִ֭שְׂרָאֵל",null,"H3478","HNp"],["he","עַֽם",null,"H5971","HNcmsc"],["he","קְרֹב֗וֹ",null,"H7138","HAamsc/Sp3ms"],["he","הַֽלְלוּ",null,"H1984","HVpv2mp"],["he","יָֽהּ",null,"H3050","HNp"]]},"gl":{"H1984":"to shine","H3050":"LORD","H853":"[Obj.]","H3068":"LORD","H4480":"from","H8064":"heaven","H4791":"height","H3605":"all","H4397":"messenger","H6635":"army","H8121":"sun","H3394":"moon","H3556":"star","H216":"light","H4325":"water","H834":"which","H5921":"upon","H8034":"name","H3588":"for","H1931":"he/she/it","H6680":"to command","H1254":"to create","H5975":"stand","H5703":"perpetuity","H5769":"enduring","H2706":"decree","H5414":"give","H3808":"not","H5674":"to pass","H776":"country/planet","H8577":"jackal","H8415":"abyss","H784":"fire","H1259":"hail","H7950":"snow","H7008":"smoke","H7307":"spirit","H5591":"tempest","H6213":"do","H1697":"word","H2022":"mount","H1389":"Gibeath-(elohim)","H6086":"wood","H6529":"fruit","H730":"cedar","H2416":"alive","H929":"animal","H7431":"creeping","H6833":"bird","H3671":"wing","H4428":"king","H3816":"people","H8269":"ruler","H8199":"to judge","H970":"youth","H1571":"also","H1330":"virgin","H2205":"elder","H5973":"with","H5288":"youth","H7682":"to exalt","H905":"pole","H1935":"splendor","H7311":"to exalt","H7161":"horn","H5971":"people","H8416":"praise","H2623":"pious","H1121":"child","H3478":"Israel","H7138":"near"},"ccc":{},"cccp":{},"com":[["haydock",1,null,"haydock","Alleluia. Septuagint, Syriac, &c., add, “of Aggæus and Zacharias,” as it seems to have been composed after the captivity, ver. 13. (Calmet) — But why might not David thus invite all to praise God? He descends from the highest creatures to those on earth. (Berthier) — Heavens. All ye blessed spirits, preach God for the excellence of your nature, and for your numbers. (Worthington)"],["haydock",2,null,"haydock","Hosts. Stars, (Calmet) or rather angels. (St. Chrysostom) (Matthew xxvi. 52.) — The three children made the same invitation to them, rejoicing in this holy communion. [Daniel iii.] (Berthier)"],["haydock",3,null,"haydock","And light. Hebrew, “of light,” meaning the planets. (Kimchi) — The harmony of these things invites us to praise the Lord. Origen and St. Hilary seem to represent them as intelligent. But (Calmet) when God is praised on their account….they all praise him. (St. Augustine) — Irrational things shew forth the excellence of their Creator. (Worthington)"],["haydock",4,null,"haydock","Of heavens. The highest and most excellent, (Calmet) though not the abode of the angels, which had been specified before. — Heavens, in the clouds. It is not necessary to allow these waters to be above the stars. (Berthier)"],["haydock",5,null,"haydock","He spoke, and they were made, is not in Hebrew or Chaldean, being taken from Psalm xxxii. 9., (Calmet) or lost in the original. (Berthier)"],["haydock",6,null,"haydock","Away. The heavenly bodies observe the most constant order. (Haydock) — They are not liable to change, like sublunary things, (Calmet) though God may suspend the laws which he has established. (Berthier)"],["haydock",7,null,"haydock","Earth. All ye inhabitants. (Haydock) — He then addresses whales, and all in the seas."],["haydock",8,null,"haydock","Word. For the punishment of the wicked, (Calmet) and to strike the saints with awe. (Haydock)"],["haydock",9,null,"haydock","Mountains. Thales, Origen, &c., have attributed souls to waters, &c. But this cannot be proved from this poetical personification. (Calmet)"],["haydock",11,null,"haydock","Kings, &c. God is to be praised for the diversity of states, whereby the whole community is preserved."],["haydock",13,null,"haydock","Alone. God, and not any idol, has disposed all things. (Worthington)"],["haydock",14,null,"haydock","Earth. All contribute towards the divine praise. Yet they cannot afford as much as God deserves. — Horn. Glory, (Calmet) or the Messias; though this cannot easily be proved to be the literal sense. (Berthier) — People. Establishing his Church. (Worthington) — Saints. Israelites, (Berthier) particularly the sacred ministers, Deuteronomy iv. 7. (Calmet) — To him. By free-will, assisted by God’s grace. (Worthington) (Hebrews xi. 6., and James iv. 8.) (Berthier)"]],"au":{"haydock":["George Leo Haydock",0,0,1849,"https://www.newadvent.org/cathen/07160a.htm"]}}