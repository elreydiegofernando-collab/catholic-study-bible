e","לֹא",null,"H3808","HTn"],["he","יִשְׁמַ֥ע",null,"H8085","HVqi3ms"],["he","אֲלֵיכֶ֖ם",null,"H413","HR/Sp2mp"],["he","פַּרְעֹ֑ה",null,"H6547","HNp"],["he","לְמַ֛עַן",null,"H4616","HR"],["he","רְב֥וֹת",null,"H7235","HVqc"],["he","מוֹפְתַ֖י",null,"H4159","HNcmpc/Sp1cs"],["he","בְּאֶ֥רֶץ",null,"H776","HR/Ncbsc","b"],["he","מִצְרָֽיִם",null,"H4714","HNp"]],"10":[["he","וּמֹשֶׁ֣ה",null,"H4872","HC/Np","c"],["he","וְאַהֲרֹ֗ן",null,"H175","HC/Np","c"],["he","עָשׂ֛וּ",null,"H6213","HVqp3cp"],["he","אֶת",null,"H853","HTo"],["he","כָּל",null,"H3605","HNcmsc"],["he","הַמֹּפְתִ֥ים",null,"H4159","HTd/Ncmpa","d"],["he","הָאֵ֖לֶּה",null,"H428","HTd/Pdxcp","d"],["he","לִפְנֵ֣י",null,"H6440","HR/Ncbpc","l"],["he","פַרְעֹ֑ה",null,"H6547","HNp"],["he","וַיְחַזֵּ֤ק",null,"H2388","HC/Vpw3ms","c"],["he","יְהוָה֙",null,"H3068","HNp"],["he","אֶת",null,"H853","HTo"],["he","לֵ֣ב",null,"H3820","HNcmsc"],["he","פַּרְעֹ֔ה",null,"H6547","HNp"],["he","וְלֹֽא",null,"H3808","HC/Tn","c"],["he","שִׁלַּ֥ח",null,"H7971","HVpp3ms"],["he","אֶת",null,"H853","HTo"],["he","בְּנֵֽי",null,"H1121","HNcmpc"],["he","יִשְׂרָאֵ֖ל",null,"H3478","HNp"],["he","מֵאַרְצֽוֹ",null,"H776","HR/Ncbsc/Sp3ms","m"]]},"gl":{"H559":"to say","H3068":"LORD","H413":"to(wards)","H4872":"Moses","H5750":"still","H5061":"plague","H259":"one","H935":"come","H5921":"upon","H6547":"Pharaoh","H4714":"Egypt","H310":"after","H3651":"right","H7971":"depart","H853":"[Obj.]","H2088":"this","H3617":"consumption","H1644":"drive out","H1696":"speak","H4994":"please","H241":"ear","H5971":"people","H7592":"to ask","H376":"man","H854":"with","H7453":"neighbor","H802":"woman","H7468":"neighbor","H3627":"article/utensil","H3701":"money","H2091":"gold","H5414":"give","H2580":"favor","H5869":"eye","H4713":"Egyptian","H1571":"also","H1419":"large","H3966":"much","H776":"country/planet","H5650":"servant/slave","H3541":"thus","H2676":"middle","H3915":"night","H589":"I","H3318":"come","H8432":"midst","H4191":"to die","H3605":"all","H1060":"firstborn","H3427":"to dwell","H3678":"throne","H5704":"till","H8198":"maidservant","H834":"which","H7347":"millstone","H929":"animal","H1961":"to be","H6818":"cry","H3644":"like","H3808":"not","H3254":"again","H1121":"child","H3478":"Israel","H2782":"to decide","H3611":"dog","H3956":"tongue","H4616":"because","H3045":"to know","H6395":"be distinguished","H996":"between","H3381":"to go down","H428":"these","H7812":"to bow","H859":"you(m.s.)","H7272":"foot","H5973":"with","H2750":"burning","H639":"anger","H8085":"hear","H7235":"to multiply","H4159":"wonder","H175":"Aaron","H6213":"do","H6440":"before","H2388":"strengthen","H3820":"heart"},"ccc":{},"cccp":{},"com":[["challoner",10,null,"challoner","The Lord hardened, etc.... See the annotations above, chap. 4.21, and chap. 7.3."],["haydock",1,null,"haydock","To Moses, before he was gone out from Pharao. (Menochius) — This revelation had been made at Mount Horeb. Calmet places the three first verses within a parenthesis; and the fourth, &c., he supposes that Moses addressed to the king at the last interview, chap. x. 29. Kennicott maintains, that the Samaritan copy preserves the unity of this awful transaction almost in its original perfection, by preserving the speech of God to Moses, part of which the Hebrew seems to address to Pharao."],["haydock",2,null,"haydock","Ask; “not borrow,” as the Protestants translate; nor “jewels of silver,” but vessels, such as the princes offered at the dedication of the tabernacle, Numbers vii. The Samaritan and Septuagint add “and raiment,” which they also asked for, (chap. xii. 35,) according to God’s command, chap. iii. 22. (Kennicott, 1. Dis. p. 391.)"],["haydock",3,null,"haydock","The Lord. The Samaritan makes this a continuation of God’s speech, “and I will give this people favour in the sight of the Egyptians, so that they shall give them what they ask. — ver. 4. For, about midnight, I will go forth into the midst of the land of Egypt. — ver. 5. And every first-born in the land of Egypt shall die, &c. (as in our fifth verse). — ver. 6. And there, &c. — ver. 7. But against any of the children of Israel shall not a dog move his tongue against man, nor even against beast, that thou mayest know that Jehovah doth put a difference between the Egyptians and Israel. — ver. 8. And thou also shalt be greatly honoured in the land of Egypt, in the sight of Pharao’s servants, and in the sight of the people. — ver. 9. Then said Moses unto Pharao, Thus sayeth Jehovah: Israel is my son, my first-born; and I said unto thee, Let my son go, that he may serve me. — ver. 10. But thou hast refused to let him go; behold! therefore Jehovah slayeth thy son, thy first-born.” — ver. 11. And Moses said, (as above, ver. 4, 5, 6, 7, 8, 9, 10.) The Jews have retained the parts of the 3rd and 8th verses, which were honourable to their nation, but they have given them as an historical narration. The 9th and 10th verses in the Samaritan copy, record what God had before commanded Moses to declare, chap. iv. 22, 33. As, therefore, all had been once written in the Hebrew text, the transcribers might probably think themselves dispensed from repeating the same things; and thus they might change some passages, and still repel the accusation of any wilful corruption, which seems to be the meaning of Ben Chaim’s preface to Bomberg’s Hebrew Bible; where he acknowledges 13 such alterations made in the copies which were presented to King Ptolemy, and translated by the Septuagint. (Kennicott, Dis. 2 p. 310.) — Moses. This exaltation of Moses and the people, took place only after the slaughter of the first-born, chap. xii. 36. Hence the Septuagint observes here, the Egyptians gave or lent them (echresan) all. (Haydock) — The greatness and dignity of Moses, impressed the king with awe, and made the people more willing to assist the Hebrews. (Menochius)"],["haydock",4,null,"haydock","I will enter, by means of a good angel, (Wisdom xviii. 14; St. Chrysostom) or by evil angels. (Psalm lxxvii. 49; St. Augustine, ibid.) (Calmet) — Moses spoke this on the morning of the 14th Nisan; and that same night, after the paschal lamb had been eaten, the dreadful carnage commenced. (Menochius)"],["haydock",5,null,"haydock","Mill. The vilest slaves were thus employed in a sort of prison, chap. xii. 21. God makes no distinction between the king and the beggar. Death levels all."],["haydock",7,null,"haydock","Dog. They shall enjoy a profound peace, (Judith xi. 5,) while Egypt is in tears. Calmet here inserts the speech from the Samaritan copy, “And the man Moses;” &c. (ver. 3, and seq.[following]) deeming it essential to the context, and very agreeable to the spirit of Moses, who has many repetitions. (Haydock)"],["haydock",9,null,"haydock","Angry, at such obstinacy. (Menochius)"],["haydock",10,null,"haydock","The Lord hardened, &c. See the annotations above, chap. iv. 21, and chap. vii. 3."]],"au":{"challoner":["Richard Challoner",0,0,1781,"https://www.newadvent.org/cathen/03566a.htm"],"haydock":["George Leo Haydock",0,0,1849,"https://www.newadvent.org/cathen/07160a.htm"]}}