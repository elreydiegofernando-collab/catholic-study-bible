,"HPp1cs"],["he","טוֹבָ֥ה",null,"H2896","HAafsa"],["he","חָכְמָ֖ה",null,"H2451","HNcfsa"],["he","מִגְּבוּרָ֑ה",null,"H1369","HR/Ncfsa","m"],["he","וְחָכְמַ֤ת",null,"H2451","HC/Ncfsc","c"],["he","הַמִּסְכֵּן֙",null,"H4542","HTd/Aamsa","d"],["he","בְּזוּיָ֔ה",null,"H959","HVqsfsa"],["he","וּדְבָרָ֖יו",null,"H1697","HC/Ncmpc/Sp3ms","c"],["he","אֵינָ֥ם",null,"H369","HTn/Sp3mp"],["he","נִשְׁמָעִֽים",null,"H8085","HVNsmpa"]],"17":[["he","דִּבְרֵ֣י",null,"H1697","HNcmpc"],["he","חֲכָמִ֔ים",null,"H2450","HAampa"],["he","בְּנַ֖חַת",null,"H5183","HR/Ncfsa","b"],["he","נִשְׁמָעִ֑ים",null,"H8085","HVNsmpa"],["he","מִזַּעֲקַ֥ת",null,"H2201","HR/Ncfsc","m"],["he","מוֹשֵׁ֖ל",null,"H4910","HVqrmsa"],["he","בַּכְּסִילִֽים",null,"H3684","HRd/Aampa","b"]],"18":[["he","טוֹבָ֥ה",null,"H2896","HAafsa"],["he","חָכְמָ֖ה",null,"H2451","HNcfsa"],["he","מִכְּלֵ֣י",null,"H3627","HR/Ncmpc","m"],["he","קְרָ֑ב",null,"H7128","HNcmsa"],["he","וְחוֹטֶ֣א",null,"H2398","HC/Vqrmsa","c"],["he","אֶחָ֔ד",null,"H259","HAcmsa"],["he","יְאַבֵּ֥ד",null,"H6","HVpi3ms"],["he","טוֹבָ֥ה",null,"H2896","HAafsa"],["he","הַרְבֵּֽה",null,"H7235","HVha"]]},"gl":{"H3588":"for","H853":"[Obj.]","H3605":"all","H2088":"this","H5414":"give","H413":"to(wards)","H3820":"heart","H952":"to explain","H834":"which","H6662":"righteous","H2450":"wise","H5652":"work","H3027":"hand","H430":"God","H1571":"also","H160":"love","H8135":"hating","H369":"nothing","H3045":"to know","H120":"man","H6440":"before","H4745":"accident","H259":"one","H7563":"wicked","H2896":"pleasant","H2889":"pure","H2931":"unclean","H2076":"to sacrifice","H2398":"to sin","H7650":"to swear","H7621":"oath","H3372":"to fear","H7451":"harmful","H6213":"do","H8478":"under","H8121":"sun","H1121":"child","H4390":"to fill","H1947":"madness","H3824":"heart","H2416":"alive","H310":"after","H4191":"to die","H4310":"who?","H977":"to choose","H2266":"to unite","H3426":"there","H986":"trust","H3611":"dog","H1931":"he/she/it","H4480":"from","H738":"lion","H3972":"anything","H5750":"still","H7939":"wages","H7911":"to forget","H2143":"memorial","H7068":"jealousy","H3528":"already","H6":"to perish","H2506":"portion","H5769":"enduring","H3212":"to walk","H398":"to eat","H8057":"joy","H3899":"food","H8354":"to drink","H3196":"wine","H7521":"to accept","H4639":"work","H6256":"time","H1961":"to be","H899":"treachery","H3836":"white","H8081":"oil","H5921":"upon","H7218":"head","H408":"not","H2637":"to lack","H7200":"see","H5973":"with","H802":"woman","H157":"lover","H3117":"day","H1892":"vanity","H5999":"trouble","H859":"you(m.s.)","H6001":"labour(er)","H4672":"to find","H3581":"reptile","H2808":"explanation","H1847":"knowledge","H2451":"wisdom","H7585":"Sheol","H1980":"went","H8033":"there","H7725":"return","H3808":"not","H7031":"swift","H4793":"race","H1368":"mighty man","H4421":"battle","H995":"to understand","H6239":"riches","H2580":"favor","H6294":"chance","H7136":"to meet","H1709":"Fish (Gate)","H270":"to grasp","H4685":"siegework","H6833":"bird","H6341":"snare","H1992":"they(masc.)","H3369":"to snare","H5307":"fall","H6597":"suddenly","H2090":"this","H1419":"large","H5892":"excitement","H6996":"small","H376":"man","H4592":"little","H935":"come","H4428":"king","H5437":"turn","H1129":"to build","H4542":"poor","H4422":"to escape","H2142":"to remember","H559":"to say","H589":"I","H1369":"might","H959":"to despise","H1697":"word","H8085":"hear","H5183":"quietness","H2201":"outcry","H4910":"to rule","H3684":"fool","H3627":"article/utensil","H7128":"battle","H7235":"to multiply"},"ccc":{},"cccp":{},"com":[["haydock",1,null,"haydock","Of God. He seems to treat both alike, so that the just themselves cannot say whether their sufferings be a punishment or a trial. (St. Jerome) (Calmet) — Knoweth not certainly, and in an ordinary manner. (Worthington) — Hatred. Hebrew and Septuagint, “yet love and hatred man knoweth not.” (Haydock) — Prosperity or adversity proves nothing. (Calmet) — Mortals cannot tell whether their afflictions tend to their greater improvement, like Job’s, or they are in punishment of sin, like those of Pharao, and of the Egyptians. This they shall know after death. (Worthington) — Yet the wicked know already that they are displeasing to God. (Salmeron in 2 Corinthians xii.) “The just and….their works are in the hand of God, even love and hatred; men know not,” &c. (De Dieu; Amama)"],["haydock",2,null,"haydock","But. Hebrew joins this with the preceding not, “by all that is before them. All things come alike to all, there is one event to,” &c. (Protestants) (Haydock) — The pagans distinguished real goods and evils from those which were only apparent, like prosperity and adversity, which are determined only by the good or bad use. (St. Jerome) — Thus religion looks upon virtue and vice in the former light; and riches, poverty, &c., in the latter. It may be difficult to decide, whether, under adversity, the just have supported themselves better by virtue, or the wicked by vanity. God will manifest the truth. (Calmet) — Perjured. Hebrew and Septuagint, “swearer, so he that fears an oath.” (Haydock)"],["haydock",3,null,"haydock","Evil. People hence take occasion to indulge in vice, (chap. viii. 14.) though the conduct of God be irreproachable. (Calmet) — Shall. Hebrew, “they go to the dead.” (Haydock) — Many think that these are the sentiments of the impious."],["haydock",4,null,"haydock","There. Even those who have had the vanity to claim divine honours, never could persuade themselves that they would escape death. But the just forms a different conclusion from the wicked. He looks upon his life only as a preparation for the other, (Hebrews xi. 13., and Ephesians ii. 19.) while libertines make haste to enjoy the fleeting pleasure, Isaias xxii. 13. To the former death seems desirable, (chap. iv. 2., and vi. 3.) to the latter it is a subject of consternation; and he prefers the vilest creature living, to the most noble when dead. (Calmet) — Hebrew, “for whosoever is chosen (yebuchar. Marginal note yechubar, “is united”) to all the living, has hope; for a,” &c. (Haydock) — Moderns generally follow the marginal reading of the Masorets. (Calmet) — “For who shall live for ever?” (Symmachus) “Who partakes with all the living? There is hope.” (Septuagint) (Haydock) — During life alone the sinner may amend, chap. ii. 3. The Gentiles are preferred before the Jews. (Worthington)"],["haydock",5,null,"challoner","Know nothing more, viz., As to the transactions of this world, in which they have now no part, unless it be revealed to them; neither have they any knowledge or power now of doing any thing to secure their eternal state, (if they have not taken care of it in their lifetime) nor can they now procure themselves any good, as the living always may do, by the grace of God. (Challoner)"],["haydock",7,null,"haydock","God. Be grateful to him, and make a good use of his benefits, (St. Jerome, exp. 2.) or these are the words of libertines. (Bossuet) (St. Jerome, 1. explicat.) (Calmet)"],["haydock",8,null,"haydock","White. As in times of joy, and among people of quality, chap. x. 17., and Proverbs xxxi. 23. — Head. Our Saviour reproaches the Pharisees for neglecting this, Luke vii. 45."],["haydock",9,null,"haydock","Wife. Some translate, “the woman,” or harlot; as if the wicked still spoke."],["haydock",10,null,"haydock","Earnestly. Live in delights, or perform many good works, chap. ii. 5. Our Lord seems to allude to this passage. What thou dost, do quickly, John xiii. 27."],["haydock",11,null,"haydock","All. Thus it appears to the inattentive, and to the wicked. For Solomon frequently inculcates that Providence directs all wisely. Human industry is not always attended with success, Deuteronomy xxix. 19. This is a fresh proof of the vanity of all things. (Calmet)"],["haydock",12,null,"haydock","With. Hebrew adds, “evil.” Net, (Montanus) or hook. (Haydock) — Them. They may use precautions; but, without God’s aid, they will not succeed, Psalm cxxvi. 1. (Calmet)"],["haydock",14,null,"haydock","And the siege, &c. Hebrew has only “great bulwarks over or against it.” (Haydock)"],["haydock",15,null,"haydock","Afterward, is not in Hebrew. The poor man was unnoticed before. (Calmet) — Vulgate insinuates that he met with no return of gratitude, which is but too common; (Haydock) and this shews the vanity of the world."],["haydock",16,null,"haydock","Heard? Ecclesiasticus xiii. 28. Men are so unjust as to despise wisdom, if it be in a poor man. The prudence of an individual has often saved cities, as was the case at Abela, and Bethulia; (2 Kings xx. 22.; Calmet) and Syracuse was defended a long time by Archimedes against the whole Roman army. (Plut.[Plutarch?] in Marcel.)"],["haydock",17,null,"jerome","Fools. Though the wise often meet with contempt, it is only among fools, who form the majority. (Calmet) — Vain declaimers in the Church shew their own folly, as well as that of their hearers. (St. Jerome)"],["haydock",18,null,"jerome","Things. A woman saved Abela; and Achan almost ruined Israel. Want of prudence in a general is often fatal. Virtues are connected, as well as vices. (Calmet) — For one transgression, many acts of virtue are lost. (St. Jerome)"],["challoner",5,null,"challoner","Know nothing more.... Viz., as to the transactions of this world, in which they have now no part, unless it be revealed to them; neither have they any knowledge or power now of doing any thing to secure their eternal state, (if they have not taken care of it in their lifetime:) nor can they now procure themselves any good, as the living always may do, by the grace of God."]],"au":{"haydock":["George Leo Haydock",0,0,1849,"https://www.newadvent.org/cathen/07160a.htm"],"challoner":["Richard Challoner",0,0,1781,"https://www.newadvent.org/cathen/03566a.htm"],"jerome":["Jerome",1,1,420,"https://www.newadvent.org/fathers/#jerome"]},"fa":[[1,null,0,"A Metaphrase of the Book of Ecclesiastes",null,0,270,"Now I thought at that time that all men were judged worthy of the same things. And if any wise man practised righteousness, and withdrew himself from unrighteousness, and as being sagacious avoided hatred with all (which, indeed, is a thing well pleasing to God), this man seemed to me to labour in vain. For there seemed to be one end for the righteous and for the impious, for the good and for the evil, for the pure and for the impure, for him that worshipped God, and for him that worshipped not. …"],[2,null,1,"Letters","Letter 108",1,420,"Except that our belief in Christ raises us up to heaven and promises eternity to our souls, the physical conditions of life are the same for us as for the brutes."],[11,null,2,"Conferences of John Cassian - Part II","13. The Third Conference of Abbot Chaeremon",2,435,"And from this it is clearly gathered by those who, led not by chattering words but by experience, measure the magnitude of grace, and the paltry limits of man's will, that \"the race is not to the swift nor the battle to the strong, nor food to the wise, nor riches to the prudent, nor grace to the learned,\" but that \"all these worketh that one and the selfsame Spirit, dividing to every man severally as He will. …"]],"fau":[["gregory-of-neocaesarea","Gregory of Neocaesarea",0,"father",null,0],["jerome","Jerome",1,"father",null,1,420],["cassian","John Cassian",0,"father",null,0,435]],"ftr":[["Ante-Nicene Fathers, vol. 6 (1886)","https://ccel.org/ccel/schaff/anf06"],["Nicene and Post-Nicene Fathers, series 2, vol. 6 (1893)","https://ccel.org/ccel/schaff/npnf206"],["Nicene and Post-Nicene Fathers, series 2, vol. 11 (1894)","https://ccel.org/ccel/schaff/npnf211"]]}